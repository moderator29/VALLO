 "sentences": [
  {
   "i": 1,
   "start": 2.308,
   "end": 6.037,
   "text": "Finding a home in Nigeria should not feel like a gamble."
  },
  {
   "i": 2,
   "start": 6.357,
   "end": 7.035,
   "text": "Meet Vallo."
  },
  {
   "i": 3,
   "start": 7.355,
   "end": 12.44,
   "text": "Search homes to rent or buy across Nigeria, and filter by exactly what you need."
  },
  {
   "i": 4,
   "start": 12.76,
   "end": 17.166,
   "text": "Open a home and see the whole move-in cost, before you call anyone."
  },
  {
   "i": 5,
   "start": 17.486,
   "end": 22.571,
   "text": "Rent, agency fee, legal fee, agreement fee, and the refundable caution deposit, all added up."
  },
  {
   "i": 6,
   "start": 22.891,
   "end": 29.332,
   "text": "On this home, rent is eighteen million naira, and the total to move in is twenty-six point one million."
  },
  {
   "i": 7,
   "start": 29.652,
   "end": 34.059,
   "text": "Want to buy instead? Every home for sale shows the same full cost."
  },
  {
   "i": 8,
   "start": 34.379,
   "end": 38.107,
   "text": "Save the ones you like, and compare two side by side."
  },
  {
   "i": 9,
   "start": 38.427,
   "end": 41.817,
   "text": "Living with someone? Split the move-in total, person by person."
  },
  {
   "i": 10,
   "start": 42.137,
   "end": 45.866,
   "text": "Got a question? Ask the AI assistant, any time of day."
  },
  {
   "i": 11,
   "start": 46.186,
   "end": 50.254,
   "text": "Going away? Book a hotel or a shortlet in a few taps."
  },
  {
   "i": 12,
   "start": 50.574,
   "end": 53.625,
   "text": "Hungry? Reserve a table at a restaurant you love."
  },
  {
   "i": 13,
   "start": 53.945,
   "end": 58.351,
   "text": "See the room, read the menu, and check every detail before you go."
  },
  {
   "i": 14,
   "start": 58.671,
   "end": 63.756,
   "text": "Then there is Vallo Circle, where you ask, share and learn about homes and areas."
  },
  {
   "i": 15,
   "start": 64.076,
   "end": 69.161,
   "text": "And Vallo Roommates, to find a roommate, or a room to share, near your school."
  },
  {
   "i": 16,
   "start": 69.481,
   "end": 71.854,
   "text": "A badge says exactly what was confirmed."
  },
  {
   "i": 17,
   "start": 72.174,
   "end": 73.869,
   "text": "Vallo never holds your money."
  },
  {
   "i": 18,
   "start": 74.189,
   "end": 77.917,
   "text": "Homes, stays, tables and people, in one app, with one account."
  },
  {
   "i": 19,
   "start": 78.237,
   "end": 79.254,
   "text": "Download Vallo today."
  },
  {
   "i": 20,
   "start": 78.462,
   "end": 80.157,
   "text": "Vallo. Real estate, done right."
  }
 ],
