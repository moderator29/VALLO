 "sentences": [
  {
   "i": 1,
   "start": 2.308,
   "end": 4.342,
   "text": "Real estate in Nigeria is moving."
  },
  {
   "i": 2,
   "start": 4.662,
   "end": 7.035,
   "text": "And Vallo is where it is going."
  },
  {
   "i": 3,
   "start": 7.355,
   "end": 11.762,
   "text": "Open a home, and see the full move-in cost before you call anyone."
  },
  {
   "i": 4,
   "start": 12.082,
   "end": 15.471,
   "text": "Rent, fees and the refundable caution deposit, all added up."
  },
  {
   "i": 5,
   "start": 15.791,
   "end": 18.503,
   "text": "Save homes, and compare two side by side."
  },
  {
   "i": 6,
   "start": 18.823,
   "end": 23.23,
   "text": "Going away? Book a hotel or a shortlet. Going out? Reserve a table."
  },
  {
   "i": 7,
   "start": 23.55,
   "end": 25.584,
   "text": "But Vallo is more than listings."
  },
  {
   "i": 8,
   "start": 25.904,
   "end": 27.26,
   "text": "This is Vallo Circle."
  },
  {
   "i": 9,
   "start": 27.58,
   "end": 31.987,
   "text": "Renters, owners, agents and professionals, sharing what they know about homes and areas."
  },
  {
   "i": 10,
   "start": 32.307,
   "end": 35.019,
   "text": "Ask about a neighbourhood before you move in."
  },
  {
   "i": 11,
   "start": 35.339,
   "end": 37.033,
   "text": "Need someone to share with?"
  },
  {
   "i": 12,
   "start": 37.353,
   "end": 41.421,
   "text": "Vallo Roommates helps you find a roommate, or a room to share."
  },
  {
   "i": 13,
   "start": 41.741,
   "end": 46.487,
   "text": "Look near your school, find other corps members, and read the safety checklist first."
  },
  {
   "i": 14,
   "start": 46.807,
   "end": 50.197,
   "text": "A badge says exactly what was confirmed, and nothing more."
  },
  {
   "i": 15,
   "start": 50.517,
   "end": 54.246,
   "text": "Your Vallo passport shows every line, until you switch it off."
  },
  {
   "i": 16,
   "start": 54.566,
   "end": 58.633,
   "text": "If you own, host or manage property, your account becomes a workspace."
  },
  {
   "i": 17,
   "start": 58.953,
   "end": 61.665,
   "text": "List a place yourself, with no agency fee."
  },
  {
   "i": 18,
   "start": 61.985,
   "end": 68.087,
   "text": "Ask the AI assistant about prices, areas or how renting works. Vallo speaks English, Hausa, Yorùbá and Igbo."
  },
  {
   "i": 19,
   "start": 68.407,
   "end": 70.102,
   "text": "This is only the start."
  },
  {
   "i": 20,
   "start": 70.422,
   "end": 74.151,
   "text": "We are building how Nigeria finds, understands and runs its spaces."
  },
  {
   "i": 21,
   "start": 74.471,
   "end": 77.183,
   "text": "Every home, every room, every table, every neighbour."
  },
  {
   "i": 22,
   "start": 77.503,
   "end": 80.553,
   "text": "Live now on the App Store and Google Play."
  },
  {
   "i": 23,
   "start": 80.873,
   "end": 81.89,
   "text": "Download Vallo today."
  },
  {
   "i": 24,
   "start": 82.21,
   "end": 83.905,
   "text": "Vallo. Real estate, done right."
  }
 ],
