<?xml version="1.0" encoding="utf-8"?>
<!--
    THE ANDROID 12+ SYSTEM SPLASH ICON: THE EXACT VALLO MARK, STILL (founder's
    ruling, 7 November 2026, replacing D68c's empty splash). Drawn at the
    centre at 76 x 65 dp, the same size and place as the mark in the launch
    overlay (`LaunchMark.java`), so when the system splash goes the overlay's
    mark is already there and the wordmark slides out from behind it.
    `launch_mark` is `public/brand/vallo-mark.svg` drawn at 304 px.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="76dp"
        android:height="65dp"
        android:gravity="center"
        android:drawable="@drawable/launch_mark" />
</layer-list>
